# syntax=docker/dockerfile:1
# Runner image for Crost self-host compose. Ships the local stack toolchain
# (Rust, zigbuild, bun, just) so `deploy/selfhost-up.sh` can invoke
# `just stack up` against the host Docker daemon via the mounted socket.
FROM debian:bookworm-slim

ARG TARGETARCH

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    build-essential \
    ca-certificates \
    clang \
    cmake \
    curl \
    docker.io \
    git \
    libssl-dev \
    mold \
    pkg-config \
    unzip \
  && rm -rf /var/lib/apt/lists/*

# zig (cargo-zigbuild)
RUN set -eux; \
  case "${TARGETARCH:-amd64}" in \
    arm64) zigarch=aarch64 ;; \
    amd64) zigarch=x86_64 ;; \
    *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
  esac; \
  curl -fsSL "https://ziglang.org/download/0.16.0/zig-linux-${zigarch}-0.16.0.tar.xz" \
    | tar -xJ -C /usr/local; \
  mv /usr/local/zig-linux-"${zigarch}"-0.16.0 /usr/local/zig
ENV PATH="/usr/local/zig:${PATH}"

# bun + Rust toolchain (matches rust-toolchain.toml 1.94.0)
RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:${PATH}"

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
  | sh -s -- -y --default-toolchain 1.94.0
ENV PATH="/root/.cargo/bin:${PATH}"
RUN rustup target add aarch64-unknown-linux-gnu x86_64-unknown-linux-gnu

RUN cargo install just --locked cargo-zigbuild@0.23.0 sqlx-cli@0.9.0 sccache@0.17.0

COPY deploy/selfhost-up.sh /usr/local/bin/macro-selfhost-up.sh
RUN chmod +x /usr/local/bin/macro-selfhost-up.sh

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/macro-selfhost-up.sh"]
