# Crost self-host configuration.
# Copy to deploy/.env before `docker compose -f deploy/docker-compose.selfhost.yml up`.
#
#   cp deploy/.env.example deploy/.env

# Stack identity (must stay consistent across up/seed/backup/status)
MACRO_INSTANCE=selfhost
MACRO_PORT_BASE=31000
# Inner xtask compose project (macro-<instance>). Not the outer runner project.
MACRO_STACK_PROJECT=macro-selfhost

# Generated env consumed by the stack orchestrator
MACRO_ENV_FILE=deploy/.env

# First-run admin: seed team-perms scenario after stack is healthy
MACRO_SELFHOST_SEED=true
MACRO_SELFHOST_SEED_FILE=seed/scenarios/team-perms.json

# W0.1 gate-3 gap: librdkafka cross-compile on macOS arm64 (ignored on Linux)
# CFLAGS=-I/opt/homebrew/opt/curl/include

# --- Local plumbing (dummy values; do not point at real cloud) ---
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# PostgreSQL service discovery is owned by the generated local-stack env.
# Do not set MACRO_DB_URL to localhost here: this file is injected into the
# service containers, where localhost means the individual service container.
# Operator-only host URL: postgres://user:password@localhost:31000/macrodb

# Object storage via LocalStack (host port = MACRO_PORT_BASE + 6)
LOCALSTACK_ENDPOINT=http://localhost:31006

# Proxy / app entrypoint (host port = MACRO_PORT_BASE + 9)
MACRO_PROXY_URL=http://localhost:31009
MACRO_FRONTEND_URL=http://localhost:31009/app/

# Crost broker -> Macro channels REST (W2.8); must match stack SERVICE_API_TOKEN
# (deterministic: local-<MACRO_INSTANCE>-service-api)
SERVICE_API_TOKEN=local-selfhost-service-api

# Mailpit for passwordless login codes (UI at /mailpit/ on the proxy)
MAILPIT_URL=http://localhost:31009/mailpit/

# FusionAuth admin (host port = MACRO_PORT_BASE + 5)
FUSIONAUTH_URL=http://localhost:31005

# Private-network access (for example, a machost Tailscale/WireGuard address).
# Replace 100.64.0.20 and uncomment all three lines together. For the default
# selfhost instance, auth is MACRO_PORT_BASE + 11 and FusionAuth is +5.
# BASE_URL=http://100.64.0.20:31011
# FUSIONAUTH_PUBLIC_URL=http://100.64.0.20:31005
# FUSIONAUTH_OAUTH_REDIRECT_URI=http://100.64.0.20:31011/oauth/redirect

# Optional Macro -> Crost broker webhook emitter (W2.7). The runner passes this
# file to xtask explicitly, so these keys reach the Macro service containers.
# Use a broker URL reachable from containers (the machost private IP works when
# brokerd binds that IP); `broker` is not a service in the Macro compose stack.
# WEBHOOK_URL=http://100.64.0.20:8080/webhooks/macro
# WEBHOOK_SECRET=replace-with-the-same-secret-as-brokerd

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET_KEY=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=
